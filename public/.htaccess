<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Domaine canonique : HTTPS + www (une seule redirection 301).
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.arthurcottey\.fr$ [NC]
    RewriteRule ^(.*)$ https://www.arthurcottey.fr/$1 [L,R=301]

    # En-têtes d'authentification.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Suppression du slash final (hors dossiers).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Contrôleur frontal Laravel.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compression.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Cache navigateur.
<IfModule mod_headers.c>
    # Fichiers versionnés par Vite (nom avec empreinte) : cache d'un an, immuable.
    <If "%{REQUEST_URI} =~ m#^/build/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Autres ressources statiques (images envoyées, icônes…) : 30 jours.
    <ElseIf "%{REQUEST_URI} =~ m#\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?)$#">
        Header set Cache-Control "public, max-age=2592000"
    </ElseIf>

    # Sécurité.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header unset X-Powered-By
</IfModule>
